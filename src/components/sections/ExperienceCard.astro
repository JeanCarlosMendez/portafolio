---
import Card from '../Card.astro'
import { Button } from '../ui/button'
import { EXPERIENCE } from '../../lib/constants'
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-2" title="Experiencia" titleEn="Experience">
  <div class="mt-2 space-y-4">
    {
      EXPERIENCE.slice(0, 3).map((exp) => (
        <div>
          <h3 class="text-lg font-semibold">
            <span data-lang-es>{exp.position}</span><span data-lang-en hidden>{exp.positionEn}</span>
          </h3>
          <a class="text-sm text-primary" href={exp?.link ?? ''}>
            {exp.company}
          </a>
          <p class="text-sm text-gray-600">
            {exp.start} - <span data-lang-es>{exp.end}</span><span data-lang-en hidden>{exp.endEn}</span>
          </p>
        </div>
      ))
    }
    <a href="/work">
      <Button variant="link" className="pl-0">
        <span data-lang-es>Ver más</span><span data-lang-en hidden>See more</span>
      </Button>
    </a>
  </div>
</Card>
