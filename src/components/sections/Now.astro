---
import Card from '../Card.astro'
import Pulse from '../Pulse.astro'
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-1">
  <div class="mb-2 flex w-full items-start justify-between">
    <div class="flex flex-col">
      <h2><span data-lang-es>Actualmente</span><span data-lang-en hidden>Now</span></h2>
    </div>
    <Pulse />
  </div>
  <p class="text-xs">
    <span data-lang-es>Ingeniero de desarrollo de software en Stone Colombia · abierto a nuevos retos.</span>
    <span data-lang-en hidden>Software development engineer at Stone Colombia · open to new challenges.</span>
  </p>
</Card>
