---
import { File } from 'lucide-react'
import Card from '../Card.astro'
import { Button } from '../ui/button'

const PDF = '/CV_JeanCarlosMendez.pdf'
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-2" title="CV" titleEn="Resume">
  <div class="mt-4 flex w-full justify-center">
    <div
      class="card card-compact md:w-112 lg:w-128 w-96 gap-2 border-[oklch(var(--p))] transition-all"
    >
      <figure>
        <object data={PDF} type="application/pdf" width="100%"></object>
      </figure>
      <div class="mt-4 flex flex-col gap-2">
        <p class="text-sm text-muted-foreground">
          <span data-lang-es>Consulta o descarga mi hoja de vida en PDF.</span>
          <span data-lang-en hidden>View or download my resume as a PDF.</span>
        </p>
        <div class="card-actions mt-2 flex w-full items-center justify-center">
          <a target="_blank" href={PDF}>
            <Button>
              <span data-lang-es>Descargar currículum</span>
              <span data-lang-en hidden>Download resume</span>
              <File />
            </Button>
          </a>
        </div>
      </div>
    </div>
  </div>
</Card>
