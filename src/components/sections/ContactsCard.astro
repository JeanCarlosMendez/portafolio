---
import Card from '../Card.astro'
import { LINKS } from '../../lib/constants'
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  <div class="h-full">
    <header class="flex items-center">
      <h1 class="text-xl font-bold text-foreground">
        <span data-lang-es>¡Construyamos algo útil!</span><span data-lang-en hidden>Let's build something useful!</span>
      </h1>
    </header>
    <address class="mt-4 flex flex-col">
      <h2 class="text-gray-500"><span data-lang-es>Detalles de contacto</span><span data-lang-en hidden>Contact details</span></h2>
      <p>jeancarlosmendez983@gmail.com</p>
      <p>Colombia</p>
    </address>
    <div class="mt-4 flex w-fit flex-col">
      <h2 class="text-gray-500"><span data-lang-es>Redes</span><span data-lang-en hidden>Socials</span></h2>
      <ul>
        <li>
          <a href={LINKS.linkedin} target="_blank">Linkedin</a>
        </li>
        <li>
          <a href={LINKS.github} target="_blank">Github</a>
        </li>
        <li>
          <a href={LINKS.youtube} target="_blank">YouTube</a>
        </li>
      </ul>
    </div>
  </div>
</Card>
