---
import { buttonVariants } from '../components/ui/button'
import { ModeToggle } from '../components/ui/ThemeToggle'
---

<script is:inline>
  document.addEventListener('astro:after-swap', function () {
    if (localStorage.getItem('theme') === 'dark')
      document.documentElement.classList.toggle('dark', true)
  })

  const getThemePreference = () => {
    return localStorage.getItem('theme')
  }

  const isDark = getThemePreference() === 'dark'
  document.documentElement.classList[isDark ? 'add' : 'remove']('dark')
</script>

<header
  class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
  <div
    class="container flex h-16 items-center space-x-4 sm:justify-between sm:space-x-0"
  >
    <div class="flex gap-6 md:gap-10">
      <a href="/" class="flex items-center space-x-2">
        <span class="inline-block font-bold">CostaGrammer</span>
      </a>
    </div>
    <div class="flex flex-1 items-center justify-end space-x-4">
      <nav class="flex items-center space-x-1">
        <a
          href="https://github.com/JeanCarlosMendez"
          target="_blank"
          rel="noreferrer"
          class={buttonVariants({ variant: 'ghost' })}
        >
          GitHub
        </a>
        <button
          id="language-toggle"
          type="button"
          class={buttonVariants({ variant: 'ghost' })}
          aria-label="Cambiar idioma"
        >
          EN
        </button>
        <ModeToggle transition:persist client:load />
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  const applyLanguage = (language) => {
    document.documentElement.lang = language
    document.querySelectorAll('[data-lang-es]').forEach((element) => {
      element.hidden = language !== 'es'
    })
    document.querySelectorAll('[data-lang-en]').forEach((element) => {
      element.hidden = language !== 'en'
    })
    const toggle = document.querySelector('#language-toggle')
    if (toggle) {
      toggle.textContent = language === 'es' ? 'EN' : 'ES'
      toggle.setAttribute('aria-label', language === 'es' ? 'Switch to English' : 'Cambiar a español')
    }
    localStorage.setItem('language', language)
  }

  window.toggleLanguage = () => {
    const language = document.documentElement.lang === 'es' ? 'en' : 'es'
    applyLanguage(language)
  }

  const initializeLanguage = () => {
    applyLanguage(localStorage.getItem('language') || 'es')
  }

  document.addEventListener('astro:after-swap', initializeLanguage)
  document.addEventListener('DOMContentLoaded', initializeLanguage)
  document.addEventListener('click', (event) => {
    if (event.target.closest('#language-toggle')) window.toggleLanguage()
  })
</script>
