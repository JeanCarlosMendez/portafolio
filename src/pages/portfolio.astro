---
import { PROJECTS } from '../lib/constants'
import BaseLayout from '../layouts/BaseLayout.astro'
import TopLayout from '../layouts/TopLayout.astro'
import BottomLayout from '../layouts/BottomLayout.astro'
import { buttonVariants } from '../components/ui/button'

---

<BaseLayout
  title={PROJECTS.TITLE}
  description={PROJECTS.DESCRIPTION}
>
  <main class="flex min-h-[80vh] flex-auto flex-col" transition:animate="slide">
    <TopLayout>
      <h2
        class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0"
      >
        <span data-lang-es>Proyectos</span><span data-lang-en hidden>Projects</span>
      </h2>
    </TopLayout>
    <BottomLayout>
      <div class="flex w-full flex-wrap justify-center gap-2">
        <div class="grid w-full gap-4 md:grid-cols-2">
          <article class="rounded-xl border p-5 shadow-sm">
            <h3 class="text-lg font-semibold"><span data-lang-es>Aplicaciones empresariales</span><span data-lang-en hidden>Business applications</span></h3>
            <p class="mt-2 text-sm text-muted-foreground">
              <span data-lang-es>Soluciones de gestión orientadas a procesos de negocio, con separación por capas, lógica mantenible y acceso seguro a datos.</span>
              <span data-lang-en hidden>Management solutions for business processes, with layered architecture, maintainable logic, and secure data access.</span>
            </p>
            <p class="mt-3 text-xs font-medium text-primary">C# · .NET 8 · SQL Server · IIS</p>
          </article>
          <article class="rounded-xl border p-5 shadow-sm">
            <h3 class="text-lg font-semibold"><span data-lang-es>APIs e integración</span><span data-lang-en hidden>APIs and integration</span></h3>
            <p class="mt-2 text-sm text-muted-foreground">
              <span data-lang-es>APIs REST y SOAP para conectar sistemas, con autenticación, gestión de sesiones y prácticas de seguridad para servicios web.</span>
              <span data-lang-en hidden>REST and SOAP APIs to connect systems, with authentication, session management, and web service security practices.</span>
            </p>
            <p class="mt-3 text-xs font-medium text-primary">ASP.NET Core · JWT · RSA · OWASP</p>
          </article>
          <article class="rounded-xl border p-5 shadow-sm">
            <h3 class="text-lg font-semibold"><span data-lang-es>Datos y automatización</span><span data-lang-en hidden>Data and automation</span></h3>
            <p class="mt-2 text-sm text-muted-foreground">
              <span data-lang-es>Procedimientos almacenados, T-SQL y acceso a datos mediante ADO.NET para construir soluciones eficientes y fáciles de operar.</span>
              <span data-lang-en hidden>Stored procedures, T-SQL, and ADO.NET data access for efficient and easy-to-operate solutions.</span>
            </p>
            <p class="mt-3 text-xs font-medium text-primary">SQL Server · T-SQL · ADO.NET</p>
          </article>
          <article class="rounded-xl border p-5 shadow-sm">
            <h3 class="text-lg font-semibold"><span data-lang-es>Exploración independiente</span><span data-lang-en hidden>Independent work</span></h3>
            <p class="mt-2 text-sm text-muted-foreground">
              <span data-lang-es>Desarrollo Android, exploración de Flutter, integraciones con servicios de IA y contenido técnico en YouTube.</span>
              <span data-lang-en hidden>Android development, Flutter exploration, AI service integrations, and technical content on YouTube.</span>
            </p>
            <p class="mt-3 text-xs font-medium text-primary">Android · Flutter · APIs de IA</p>
          </article>
        </div>
      </div>
      <br/>
      <br/>
      <a href="/" rel="noreferrer" class={buttonVariants()}><span data-lang-es>Regresar al inicio</span><span data-lang-en hidden>Back home</span></a>
    </BottomLayout>
  </main>
</BaseLayout>
